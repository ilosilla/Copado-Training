<?xml version="1.0" encoding="UTF-8"?>
<LightningComponentBundle xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>64.0</apiVersion>
    <isExposed>true</isExposed>
    <masterLabel>B2B: US Dealers Product Detail Page</masterLabel>
    <targets>
        <target>lightningCommunity__Page</target>
        <target>lightningCommunity__Page_Layout</target>
        <target>lightningCommunity__Default</target>
        <target>lightningCommunity__Theme_Layout</target>
    </targets>
    <targetConfigs>
        <targetConfig targets="lightningCommunity__Default">
            <property name="productId" type="String" label="Product ID" />
            <property name="productCode" type="String" label="Product Code" />
            <property name="productName" type="String" label="Product Name" />
            <property name="pricebookEntryId" type="String" label="Pricebook Entry ID" />
            <!--
            <property name="salesUnit" type="String" label="Sales Unit" />
            <property name="salesPrice" type="String" label="Sales Price" />
            <property name="listUnit" type="String" label="List Unit" />
            <property name="listPrice" type="String" label="List Price" />
            -->
            <property name="quantity" type="String" label="Quantity" />                        
        </targetConfig>
    </targetConfigs>
    <capabilities>
        <capability>lightningCommunity__RelaxedCSP</capability>
    </capabilities>

</LightningComponentBundle>