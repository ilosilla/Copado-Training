			<property name="NB2B_ContactPointAddress" type="String" label="NB2B_ContactPointAddress" description="NB2B_ContactPointAddress" />

			<property name="cartDeliveryGroupId" type="String" label="cartDeliveryGroupId" description="cartDeliveryGroupId" />

			<property name="deliveryInstructions" type="String" label="deliveryInstructions" description="deliveryInstructions" role="inputOnly"/>
