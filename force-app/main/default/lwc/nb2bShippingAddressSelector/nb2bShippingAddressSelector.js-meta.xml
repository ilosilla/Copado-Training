			<property name="selectedDate" type="Date" label="Selected date" description="The selected date" role="outputOnly"/>
			<property name="addressId" type="String" label="contactPointId" description="contactPointId" role="outputOnly"/>
			<property name="porcelanosaAddressId" type="String" label="porcelanosaAddressId" description="porcelanosaAddressId" role="outputOnly"/>

			<property name="deliveryGroup" type="String" label="Delivery Group" role="inputOnly"/>
