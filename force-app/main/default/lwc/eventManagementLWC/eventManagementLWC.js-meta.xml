<?xml version="1.0" encoding="UTF-8"?>
<LightningComponentBundle xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>63.0</apiVersion>
    <targets>
        <target>lightning__FlowScreen</target>
    </targets>
    <targetConfigs>
        <targetConfig targets="lightning__FlowScreen">
            <property name="accountId" type="String" label="Account Id" description="Account Id, to show its related contacts"/>
            <property name="selectedContactId" type="String" label="Contact Id" description="Selected contact"/>
            <property name="fullPage" type="String" label="Full Page" default="false" description="Shown on full page"/>
            <property name="contactsArray" type="@salesforce/schema/EventRelation[]" label="Contacts Related" default="[]" description="Contacts related list"/>
            <property name="eventId" type="String" label="Event Id" description="Event Id"/>
        </targetConfig>
    </targetConfigs>
    <isExposed>true</isExposed>
</LightningComponentBundle>