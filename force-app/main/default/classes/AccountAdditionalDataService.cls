public with sharing class AccountAdditionalDataService {

    public static void getPappersData(Set<String> sirens) {
        // Get All Data
        for (String siren : sirens) {
            PappersService.getAPIData(siren);
        }
    }

    public static void setPappersData(Set<String> sirens) {
        List<AccountAdditionalInfo__c> listFinances = PappersService.setData(sirens);
        PappersService.deleteData(sirens);
        insert listFinances;
    }

    public static void setSAPDocumentsData(String accountId) {
        Account acc = new AccountsSelector().selectById(accountId);
        List<Facturas_cabeceraSet__x> invoicesData = (List<Facturas_cabeceraSet__x>) AccountAdditionalData.getInvoices(acc.Sap_id__c);
        List<Pedidos_cabeceraSet__x> ordersData = (List<Pedidos_cabeceraSet__x>) AccountAdditionalData.getOrders(acc.Sap_id__c);
        Map<String, Map<String, Decimal>> invoicesDataGrouped = AccountAdditionalData.processDocumentLines(invoicesData, 'INVOICES');
        Map<String, Map<String, Decimal>> ordersDataGrouped = AccountAdditionalData.processDocumentLines(ordersData, 'ORDERS');
        List<AccountAdditionalInfo__c> listFinances = AccountAdditionalData.createInvoicesData(invoicesDataGrouped, accountId);
        listFinances.addAll(AccountAdditionalData.createOrdersData(ordersDataGrouped, accountId));
        AccountAdditionalData.deleteData(accountId);
        insert listFinances;
    }

    @AuraEnabled(cacheable=true)
    public static List<AccountAdditionalInfo__c> getAdditionalData(String accountId) {
        List<AccountAdditionalInfo__c> additionalData = [select id,account__c, InfoType__c,Year__c,  Brand__c, Quantity__c  from AccountAdditionalInfo__c where Account__c =: accountId];
        return additionalData;
    }

