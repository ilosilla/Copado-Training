global class OppPriceRequestsDomain {

    public final static String PRICE_REQUEST_SERVICE = '/api/price_request';

    public static String sendItemsApprovedToSap(List<OppPriceRequestItem__c> approvedItems) {
        priceRequestDTO pRequestData = parseData(approvedItems);
        String jsonToSAP = JSON.serializePretty(pRequestData, true);
        System.debug('JSON TO SAP - ' + jsonToSAP);

        // ENVIAR TODO A SAP
        SAPWS_Utility.SapResponse response = SAPConnector.connect('', PRICE_REQUEST_SERVICE, 'POST', jsonToSAP);
        if (response.success == false) {
            System.debug('RESPONSE');
            System.debug(response);
            throw new OppPriceRequestComponentController.PriceRequestException(System.Label.prequest_general_error);
        }

        // TODO HA IDO BIEN:
        OppPriceRequestHeader__c pRequestHeader = [SELECT Id, ApproveCode__c FROM OppPriceRequestHeader__c WHERE Id =: approvedItems[0].PriceRequestHeader__c];
        if (String.isEmpty(pRequestHeader.ApproveCode__c)) {
            pRequestHeader.ApproveCode__c = (String) pRequestData.approveCode;
            update pRequestHeader;
        }

        return pRequestHeader.ApproveCode__c;
    }

    public static priceRequestDTO parseData(List<OppPriceRequestItem__c> approvedItems) {
        List<priceRequestItemDTO> itemsList = new List<priceRequestItemDTO>();
        OppPriceRequestsDomain.priceRequestDTO header = new OppPriceRequestsDomain.priceRequestDTO();  

        OppPriceRequestHeader__c pRequestHeader = [SELECT Id, ApproveCode__c, Opportunity__c FROM OppPriceRequestHeader__c WHERE Id =: approvedItems[0].PriceRequestHeader__c];
        List<OpportunityContactRole> contactRoles = new OpportunityContactRolesSelector().selectByOpportunity(pRequestHeader.Opportunity__c);
        Set<Id> setAccountIds = new Set<Id>();
        for (OpportunityContactRole contactRole : contactRoles) {
            setAccountIds.add(contactRole.Account__c);
        }
        List<Account> accountsRelated = new AccountsSelector().selectById(setAccountIds);

        header.accountsExtra = new List<String>();
        for (Account accRelated : accountsRelated) {
            if (accRelated.sap_id__c != null) {
                header.accountsExtra.add(accRelated.sap_id__c);
            }
        }

        if (approvedItems.size() > 0) {
            Id priceRequestHeaderId = approvedItems[0].PriceRequestHeader__c;
            OppPriceRequestHeader__c priceRequestHeader = [SELECT Notes__c, SalesOrg__c, Currency__c, ApproveCode__c, Opportunity__c,Opportunity__r.Account.Id,
            Opportunity__r.Account.sap_id__c, Opportunity__r.Owner.Default_Sales_Organization__c , Status__c
                FROM OppPriceRequestHeader__c WHERE Id =: priceRequestHeaderId];

            for (OppPriceRequestItem__c item : approvedItems) {
                OppPriceRequestsDomain.priceRequestItemDTO auxItem = new OppPriceRequestsDomain.priceRequestItemDTO();
                auxItem.approvePrice = item.ApprovedPrice__c;
                auxItem.currencyCode = item.CurrencyIsoCode;
                auxItem.units = item.UnitOfPrice__c;
                auxItem.productId = item.ProductCode__c;
                itemsList.add(auxItem);
            }

            header.salesOrg = priceRequestHeader.SalesOrg__c;
            header.accountId = priceRequestHeader.Opportunity__r.AccountId;
            header.accountSapId = priceRequestHeader.Opportunity__r.Account.sap_id__c;
            header.opportunityId = priceRequestHeader.Opportunity__c;
            DateTime dt = Datetime.now();
            header.approveDateFrom = dt.addDays(-90).format('yyyyMMdd');
            header.approveDateTo = dt.addDays(365).format('yyyyMMdd');
            if (String.isEmpty(priceRequestHeader.ApproveCode__c)) {
                header.approveCode = dt.format('ddMMyyHHmmss');
            } else {
                header.approveCode = priceRequestHeader.ApproveCode__c;
            }
            header.approveEmail = approvedItems[0].Approver__r.Email;
            header.items = itemsList;
        }

        return header;
    }

    global class priceRequestItemDTO {
        global String productId;
        global Decimal approvePrice;
        global String units;
        global String currencyCode;
    }

    global class priceRequestDTO {
        global String salesOrg;
        global String accountId;
        global String accountSapId;
        global String opportunityId;
        global String approveCode;
        global String approveEmail;
        global String approveDateFrom;
        global String approveDateTo;
        global List<Object> items;
        global List<String> accountsExtra;
    }

