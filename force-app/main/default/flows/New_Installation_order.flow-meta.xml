        <locationX>523</locationX>
        <locationY>191</locationY>
        <defaultConnector>
            <targetReference>State_Error</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Not Closed Won</defaultConnectorLabel>
        <rules>
            <name>Is_Closed_Won</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>GetRequestRecord.State__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Closed Won</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>GetInstallationOrders</targetReference>
            </connector>
            <label>Is Closed Won</label>
        </rules>
    </decisions>
