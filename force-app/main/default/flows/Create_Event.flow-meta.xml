    <formulas>
        <name>EndOfWeek</name>
        <dataType>DateTime</dataType>
        <expression>DATETIMEVALUE(
    TEXT(DATE(
        YEAR(TODAY()),
        MONTH(TODAY()),
        DAY(TODAY()) - WEEKDAY(TODAY()) + 6
    )) &amp; &quot; 23:59:00&quot;
)</expression>
    </formulas>
    <formulas>
        <name>StartOfWeek</name>
        <dataType>DateTime</dataType>
        <expression>DATETIMEVALUE(
    TEXT(TODAY() - WEEKDAY(TODAY()) + 2) &amp; &quot; 00:00:00&quot;
)</expression>
    </formulas>
    <formulas>
        <name>validDates</name>
        <dataType>Boolean</dataType>
        <expression>NOT(
    AND(
       {!Start} &gt;= DATETIMEVALUE(TEXT(DATE(YEAR(TODAY()), MONTH(TODAY()), DAY(TODAY()) - WEEKDAY(TODAY()) + 2)) &amp; &quot; 00:00:00&quot;),
       {!End} &lt;= DATETIMEVALUE(TEXT(DATE(YEAR(TODAY()), MONTH(TODAY()), DAY(TODAY()) - WEEKDAY(TODAY()) + 8)) &amp; &quot; 23:59:59&quot;)
    )
)</expression>
    </formulas>
