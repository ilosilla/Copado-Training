<aura:component implements="flexipage:availableForAllPageTypes,force:hasRecordId,forceCommunity:availableForAllPageTypes" access="global">    
    
    <!-- Attributes -->
    <aura:attribute name="title" type="String" required="true"
                   	description="Title of the component"/>
    <aura:attribute name="flowName" type="String"  required="true"
                    description="API name of the Flow to display"/>   
        
    <!-- Local attributes -->
    <aura:attribute name="innerEvent" type="Boolean" default="false"/>
    <aura:attribute name="recordId" type="String"/>
    <aura:attribute name="record" type="Object"/>
    <aura:attribute name="simpleRecord" type="Object"/>
    <aura:attribute name="recordError" type="String"/>

    <!-- We only use this for its `recordUpdated` event mechanism -->
    <force:recordData aura:id="record"
                      layoutType="FULL"
                      recordId="{!v.recordId}"
                      targetError="{!v.recordError}"
                      targetRecord="{!v.record}"
                      targetFields="{!v.simpleRecord}"
                      recordUpdated="{!c.handleRecordUpdated}"
                      mode="VIEW"/>    
    
    <!-- Handlers -->
    <aura:handler name="init" value="{!this}" action="{!c.init}" />
    <!-- aura:handler event="force:refreshView" action="{!c.reload}"/ -->
        
    <!-- Markup -->
    <article class="slds-card">
        <!-- Header -->
        <header class="slds-border_bottom">
            <div class="slds-media slds-media_center slds-has-flexi-truncate slds-page-header slds-border_bottom" >
                <div class="slds-media__figure">
                    <lightning:icon iconName="standard:actions_and_buttons" size="small"/>
                </div>
                <div class="slds-media__body">
                    <h2 class="slds-card__header-title">
                        <span class="slds-card__header-link slds-truncate" title="{!v.title}">
                            <span>{!v.title}</span>
                        </span>
                    </h2>
                </div>
            </div>
        </header>
        
        <!-- Body -->
        <div aura:id="flowContainerOut" class="slds-card__body slds-card__body_inner">
			<!-- <lightning:flow aura:id="flowData"/> -->   
            <span aura:id="flowContainer"></span>
		</div>
        
		<footer class="slds-card__footer">  
        </footer>
        <!-- Footer -->
	</article>
</aura:component>