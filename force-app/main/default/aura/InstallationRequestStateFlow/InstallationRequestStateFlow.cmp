<aura:component implements="flexipage:availableForAllPageTypes,force:hasRecordId,forceCommunity:availableForAllPageTypes" access="global">    
    
    <aura:handler name="init" value="{!this}" action="{!c.init}" />
        
    <article class="slds-card">
        <!-- Header -->
        <header class="slds-border_bottom">
            <div class="slds-media slds-media_center slds-has-flexi-truncate slds-page-header slds-border_bottom" >
                <div class="slds-media__figure">
                    <lightning:icon iconName="standard:actions_and_buttons" size="small"/>
                </div>
                <div class="slds-media__body">
                    <h2 class="slds-card__header-title">
                        <span class="slds-card__header-link slds-truncate" title="Accounts">
                            <span>Next Action</span>
                        </span>
                    </h2>
                </div>
            </div>
        </header>
        
        <!-- Body -->
        <div aura:id="flowContainer" class="slds-card__body slds-card__body_inner">
			<lightning:flow aura:id="flowData" />            
		</div>
        
		<footer class="slds-card__footer">  
        </footer>
        <!-- Footer -->
	</article>
</aura:component>