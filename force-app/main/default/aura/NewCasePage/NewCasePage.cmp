<aura:component
    implements="flexipage:availableForAllPageTypes,force:hasRecordId,lightning:hasPageReference,lightning:isUrlAddressable,lightning:actionOverride,force:lightningQuickActionWithoutHeader" 
    access="global" controller="NewCasePageController">
    <aura:attribute name="recordTypes" type="List" default="[]"/>
    <aura:attribute name="selectedRecordType" type="String" default=""/>
    <aura:attribute name="sapInvoiceId" type="String" default=""/>
    
    <aura:handler name="init" value="{!this}" action="{!c.onLoadPage}"/>
    <lightning:navigation aura:id="navService"/>
    <lightning:workspaceAPI aura:id="workspace"/>

    <div style="width:100%;min-height:100%; height:100%;">
        <div class="slds-card slds-box" style="margin: 0 auto; width:50%; min-height:100%; height:100%; padding:0 6px;">
            <div  class="slds-p-horizontal_medium slds-size_full"  style="overflow-y:auto">
                <h2 class="slds-text-heading_medium slds-m-top_medium slds-p-bottom_medium slds-p-horizontal_medium slds-border_bottom">{!$Label.c.case_new_case_title}</h2>                
                <div class="slds-p-around_medium">
                    <lightning:radioGroup name="recordTypesRadio"
                        options = "{!v.recordTypes}"
                        value = "{!v.selectedRecordType}"
                        variant = "label-stacked"
                        type = "radio"
                    />
                </div>
                <div class="slds-p-around_medium slds-p-top_large slds-border_top" style="text-align:center; width: 100%;">    
                    <lightning:button label="{!$Label.c.dict_button_cancel}"  onclick="{! c.handleCancelClick }"/>
                    <lightning:button variant="brand" label="{!$Label.c.dict_button_next}" onclick="{! c.handleNextClick }" />
                </div>

            </div>
        </div>
    </div>
        <!-- <button onclick='{!c.navega}'>NAVEGAR</button> -->
                        
</aura:component>