<!--
    - @author 		Ramón Prades
    - @date 		May 2021
    - @group 		Tools
    - @description 	Component to render a component in a modal window
-->
<aura:component description="Component for rendering modal window" extensible="true">
    
    <aura:attribute name="isActive" type="Boolean" default="false" required="true" />
    <aura:attribute name="title" type="String" default="This is the title" required="false" />
    <aura:attribute name="variant" type="String" default="VIEW" required="false" />
    <!-- aura:attribute name="footer" type="Aura.Component[]" required="false" / -->

    <aura:registerEvent name="cmpCommand" type="c:ComponentCommandEvent"/>

    <div>
        <aura:renderIf isTrue="{!v.isActive}">
            <section role="dialog" tabindex="-1" aria-label="Meaningful description of the modal content" aria-describedby="modal-content-id-1" class="slds-modal slds-fade-in-open">
                <div class="slds-modal__container">
                    <header class="{!'slds-modal__header' + (empty(v.title) ? ' slds-modal__header slds-modal__header_empty' : '')}">
                        <lightning:buttonIcon alternativeText="Close" onclick="{!c.handleClose}" iconName="utility:close" variant="bare" size="large" class="slds-modal__close slds-button_icon-inverse" />
                        <aura:renderIf isTrue="{!not(empty(v.title))}">
                            <h2 class="slds-text-heading_medium slds-hyphenate">{!v.title}XXX</h2>
                        </aura:renderIf>
                    </header>
                    <div class="slds-modal__content slds-p-around--large" id="modal-content-id-1">
                        This is the body
                        {!v.body}
                    </div>
                    <footer class="slds-modal__footer">
                        <aura:if isTrue="{!v.variant == 'EDIT'}">
                            <lightning:button variant="neutral" label="Cancel" onclick="{!c.handleClose}" />
                            <lightning:button variant="brand" label="Save" onclick="{!c.onModalSave}" />
                        </aura:if>
                        <aura:if isTrue="{!v.variant == 'VIEW'}">
                            <lightning:button variant="neutral" label="Close" onclick="{!c.handleClose}" />
                        </aura:if>
                    </footer>
                </div>
            </section>
        </aura:renderIf>

        <div class="{!'slds-backdrop ' + ((v.isActive) ? 'slds-backdrop_open' : 'slds-backdrop_close')}"></div>

    </div>

</aura:component>