                                    <div class="slds-form-element__label">netwr</div>
                                    <lightning:formattedNumber value="{! item.netwr }" style="decimal"/>
                                    
                                </lightning:layoutItem>
                                
                                <lightning:layoutItem size="1" flexibility="auto" padding="around-small" >
                                    <div class="slds-form-element__label">mwsbp</div>
                                    <lightning:formattedNumber value="{! item.mwsbp }" style="decimal"/>
                                    
                                </lightning:layoutItem>
                                
                                <lightning:layoutItem size="1" flexibility="auto" padding="around-small" >
                                    <div class="slds-form-element__label">total</div>
                                    <lightning:formattedNumber value="{! item.total }" style="decimal"/>
                                    
                                </lightning:layoutItem>
                                
                                <lightning:layoutItem size="1" flexibility="auto" padding="around-small" >
                                    <div class="slds-form-element__label">vbtyp</div>
                                    <b><lightning:formattedText value="{! item.vbtyp }" /></b>
                                    
                                </lightning:layoutItem>
                                
                                <lightning:layoutItem size="1" flexibility="auto" padding="around-small" >
                                    <div class="slds-form-element__label">auart</div>
                                    <b><lightning:formattedText value="{! item.auart }" /></b>
                                    
                                </lightning:layoutItem>
                                
                                <lightning:layoutItem size="1" flexibility="auto" padding="around-small" >
                                    <div class="slds-form-element__label">kunnr</div>
                                    <b><lightning:formattedText value="{! item.kunnr }" /></b>
                                    
                                </lightning:layoutItem>
                                
                                <lightning:layoutItem size="1" flexibility="auto" padding="around-small" >
                                    <div class="slds-form-element__label">name1</div>
                                    <b><lightning:formattedText value="{! item.name1 }" /></b>
                                    
                                </lightning:layoutItem>
                                
                                <lightning:layoutItem size="1" flexibility="auto" padding="around-small" >
                                    <div class="slds-form-element__label">vbtyp</div>
                                    <b><lightning:formattedText value="{! item.bukrs_vf }" /></b>
                                    
                                </lightning:layoutItem>
                                
                            </lightning:layout>
                            
                        </aura:iteration>
        
                    </aura:if>
        -->            <div class=" slds-scrollable">
                    <table class="slds-table slds-table_cell-buffer slds-table_bordered">
                        <thead>
                            <tr class="slds-line-height_reset">
                                <th class="" scope="col">
                                    <div class="slds-truncate" title="Order number">Order number</div>
                                </th>
                                <th class="" scope="col">
                                    <div class="slds-truncate" title="Order date">Order date</div>
                                </th>
                                <th class="" scope="col">
                                    <div class="slds-truncate" title="Customer reference">Customer reference</div>
                                </th>
                                <th class="" scope="col">
                                    <div class="slds-truncate" title="Net worth">Net worth</div>
                                </th>
                                <th class="" scope="col">
                                    <div class="slds-truncate" title="Taxation">Taxation</div>
                                </th>
                                <th class="" scope="col">
                                    <div class="slds-truncate" title="Total">Total</div>
                                </th>
                                <th class="" scope="col">
                                    <div class="slds-truncate" title="Order type">Order type</div>
                                </th>
                                <th class="" scope="col">
                                    <div class="slds-truncate" title="Document type">Document type</div>
                                </th>
                                <th class="" scope="col">
                                    <div class="slds-truncate" title="Client SAP Id">Client SAP Id</div>
                                </th>
                                <th class="" scope="col">
                                    <div class="slds-truncate" title="Client Name">Client Name</div>
                                </th>
                                <th class="" scope="col">
                                    <div class="slds-truncate" title="Company">Company</div>
                                </th>
                            </tr>
                        </thead>
                        <tbody>
                            
                            <aura:iteration items="{! v.tableSource}" var="item"> 
                                
                                <tr class="slds-hint-parent">
                                    <th data-label="Opportunity Name" scope="row">
                                        <div class="slds-truncate" title="Cloudhub"><h3>{! item.vbeIn}</h3></div>
                                    </th>
                                    <td data-label="Status">
                                        <div class="slds-truncate" title="">{! item.audat}</div>
                                    </td>
                                    <td data-label="Status">
                                        <div class="slds-truncate" title="">{! item.bstnk}</div>
                                    </td>
                                    <td data-label="Status">
                                        <div class="slds-truncate" title="">{! item.netwr}</div>
                                    </td>
                                    <td data-label="Status">
                                        <div class="slds-truncate" title="">{! item.mwsbp}</div>
                                    </td>
                                    <td data-label="Status">
                                        <div class="slds-truncate" title="">{! item.total}</div>
                                    </td>
                                    <td data-label="Status">
                                        <div class="slds-truncate" title="">{! item.vbtyp}</div>
                                    </td>
                                    <td data-label="Status">
                                        <div class="slds-truncate" title="">{! item.auart}</div>
                                    </td>
                                    <td data-label="Status">
                                        <div class="slds-truncate" title="">{! item.kunnr}</div>
                                    </td>
                                    <td data-label="Status">
                                        <div class="slds-truncate" title="">{! item.name1}</div>
                                    </td>
                                    <td data-label="Status">
                                        <div class="slds-truncate" title="">{! item.bukrs_vf}</div>
                                    </td>
                                    
                                </tr>
                                
                            </aura:iteration>  
                        </tbody>
                    </table>
                    </div>
                </div>
            </ui:scrollerWrapper>
        </div>
    </div>
    <div aura:id="overlay" class="slds-backdrop slds-backdrop--open"></div>
    
