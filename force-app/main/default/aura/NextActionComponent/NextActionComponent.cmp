<!--
	Componente para mostrar los textos del NextActionText__c.
	Recibe 2 atributos:
		- variant: Indica cmo se muestra el texto: TOAST, BOX o SECTION
		- recordId: Id del objeto en el que se basa el componente para mostrar el texto. Si no se pasa, coge el recordId de la página.
-->
<aura:component
  implements="flexipage:availableForAllPageTypes,force:appHostable,force:hasRecordId"
  access="global"
  controller="NextActionComponentController">    
    <!-- component attributes -->
    <aura:attribute name="title" type="String"/>
    <aura:attribute name="variant" type="String" default="SECTION"/>
    
    <!-- data attributes -->
    <aura:attribute name="recordId" type="String"/>
    <aura:attribute name="stageName" type="String"/>
    <aura:attribute name="divOpen" type="String" default="slds-is-open"/>
    <aura:attribute name="labelName" type="String" />
    <aura:attribute name="labelReference" type="String"/>
    <aura:attribute name="textToShow" type="String" />
    <aura:attribute name="ready" type="Boolean" default="false"/>

    <aura:handler name="init" action="{!c.onLoad}" value="{!this}" />
    <aura:handler name="change" value="{!v.labelReference}" action="{!c.labelLoaded}"/>
    <aura:method name="refresh" action="{!c.refreshComponent}" access="public">
        <aura:attribute name="stage" type="String"/> 
    </aura:method>    
    <!-- aura:handler event="c:eventOnChange" action="{!c.refreshComponent}"/ -->
    
    <aura:if isTrue="{! v.variant == 'SECTION' || v.variant == 'section'}">
        <aura:if isTrue="{! and(v.labelReference != null, v.ready == true) }">
            <div class="{! 'slds-section ' + v.divOpen }">
                <h3 class="slds-section__title">
                    <button aria-controls="expando-unique-id" aria-expanded="true" class="slds-button slds-section__title-action" onclick="{! c.swapDivOpen }">
                        <aura:if isTrue="{! v.divOpen == '' }">
                            <lightning:icon iconName='utility:chevronright' alternative-text='chevronright' class="slds-p-right--xx-small" size='x-small' title='show text'/>
                        	<aura:set attribute="else">
                                <lightning:icon iconName='utility:chevrondown' alternative-text='chevrondown' class="slds-p-right--xx-small" size='x-small' title='hide text'/>
                            </aura:set>
                        </aura:if>
                        <span class="slds-truncate" title="Section Title">{! v.title }</span>
                    </button>
                </h3>
                <div aria-hidden="false" class="slds-section__content slds-card slds-scrollable_y slds-p-horizontal_medium" id="expando-unique-id">
                    <div class="slds-p-horizontal_medium" style="height:6rem">
                        <ui:outputRichText class="slds-p-horizontal_medium slds-scrollable_y" value="{! v.labelReference }" />
                    </div>
                </div>
            </div>
        </aura:if>
    </aura:if>

    <aura:if isTrue="{! v.variant == 'BOX' || v.variant == 'box'}">
        <aura:if isTrue="{! and(v.labelReference != null, v.ready == true) }">
            <div class="slds-box  slds-theme_shade .slds-theme_alert-texture">
                <h3 class="slds-section__title">
                    <span class="slds-truncate" title="Section Title"><b>{! v.title }</b></span>
                </h3>
                <div class="slds-scrollable_y slds-p-horizontal_medium">
                    <div style="max-height:6rem">
                        <ui:outputRichText class="slds-scrollable_y" value="{! v.labelReference }" />
                    </div>
                </div>
            </div>
        </aura:if>
    </aura:if>    
   
</aura:component>