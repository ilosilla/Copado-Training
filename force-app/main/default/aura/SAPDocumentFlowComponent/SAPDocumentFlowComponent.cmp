<aura:component implements="lightning:availableForFlowScreens" access="global">
    
    <!-- ATTRIBUTES -->
	<aura:attribute name="docType" type="String" access="global" />    
    <aura:attribute name="docNumber" type="String" access="global" />   
    <aura:attribute name="docLabel" type="String" access="global"/> 
    <aura:attribute name="required" type="Boolean" access="global" default="false"/>
    
	<aura:attribute name="validate" type="Aura.Action" 
                    description="Custom validation function to run when the flow is navigated to the next screen."/>    

    <!-- HANDLERS -->
    <aura:handler name="init" value="{!this}" action="{!c.init}"/>
    
    <!-- MARKUP -->
	<lightning:input class="sapdoc" type="text" label="{!v.docLabel}" required="{!v.required}" value="{!v.docNumber}" 
                     maxlength="10" minlength="8" pattern="^\d+$"></lightning:input>
</aura:component>