<aura:component implements="flexipage:availableForAllPageTypes,force:hasSObjectName,force:hasRecordId,lightning:actionOverride,force:lightningQuickAction"
	access="global">

    <aura:handler name="init" value="{!this}" action="{!c.init}"/>
   <lightning:flow aura:id="flowData" onstatuschange="{!c.handleFlowStatusChange}"/>

</aura:component>