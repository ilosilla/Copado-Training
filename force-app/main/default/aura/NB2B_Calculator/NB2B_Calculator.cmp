        </div>
     
    </div>
       <div class="slds-modal__footer" style="width: 80%;">
      <button class="slds-button slds-button_neutral" onclick="{! c.addToCart }" aria-label="Cancel and close">CANCEL</button>
      <button class="slds-button slds-button_brand" onclick="{! c.createCartItem }" style="background:#1c3241;color:white;border-radius:0px;">OK</button>
    </div>
</aura:component>