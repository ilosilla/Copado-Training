<aura:component access="global" controller="NB2B_AreaCalculationController" 
                implements="force:lightningQuickActionWithoutHeader,force:hasRecordId,forceCommunity:availableForAllPageTypes">
	<div class="slds-grid slds-gutters" style="width: 80%;">
        <div class="slds-col slds-size_2-of-3">
            <span>
                <div class="slds-m-top_medium slds-m-bottom_x-large">
                    <div class="slds-p-around_medium lgc-bg">
                        <span>
                            <h1 class="slds-text-heading_medium slds-m-bottom_medium">
                            	<b>SHINE DARK L 33,3X59,2(A)</b>
                            </h1>
                            <h5 class="slds-text-heading_medium slds-m-bottom_medium" style="color:grey">
                                by Porcelanosa
                            </h5>
                        </span>
                    </div>
                    <div class="slds-p-around_medium lgc-bg">
                        <span>
                            
                            <div class="slds-grid slds-gutters">
                              <div class="slds-col  slds-size_1-of-2">
                                <span>
                                    Square Meters:
                                </span>
                              </div>
                              <div class="slds-col  slds-size_1-of-2">
                                <span>
									<input type="number"/>
                                </span>
                              </div>
                            </div>
                            <br/>
                            <div class="slds-grid slds-gutters">
                              <div class="slds-col slds-size_1-of-2">
                                <span>
                                    Pallets:
                                </span>
                              </div>
                              <div class="slds-col slds-size_1-of-2">
                                <span>
									<input type="number"/>
                                </span>
                              </div>
                            </div>
                            <br/>
                            <div class="slds-grid slds-gutters">
                              <div class="slds-col slds-size_1-of-2">
                                <span>
                                    Boxes:
                                </span>
                              </div>
                              <div class="slds-col slds-size_1-of-2">
                                <span>
									<input type="number"/>
                                </span>
                              </div>
                            </div>
                            <br/>
                            <div class="slds-grid slds-gutters">
                              <div class="slds-col slds-size_1-of-2">
                                <span>
                                    Pieces:
