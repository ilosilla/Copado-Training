                                <span>
									<input type="number"/>
                                </span>
                              </div>
                            </div>
                        </span>
                    </div>
                    <div class="slds-p-around_medium lgc-bg">
                        <span>
                            <h5 class="slds-text-heading_medium slds-m-bottom_medium" style="font-size: medium;">
                                <b>Quantity to Order: 27 Boxes (23,55 M2)</b>
                            </h5>
                        </span>
                    </div>
					<!--<div class="slds-p-around_medium lgc-bg">
                        <span>
                        	<button class="slds-button slds-button_brand" 
		                            style="background:#1c3241;color:white;border-radius:0px;">Cancel
                                    </button>    
                        </span>
                    </div>-->
                </div>
            </span>
        </div>
        <div class="slds-col slds-size_1-of-3" style="border-left: grey;border-left-style: solid;">
            <div class="slds-p-around_medium lgc-bg">
                        <span>
                            <div class="slds-col slds-size_1-of-3">
                            <span>
