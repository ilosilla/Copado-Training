<?xml version="1.0" encoding="UTF-8"?>
<ApprovalProcess xmlns="http://soap.sforce.com/2006/04/metadata">
    <active>false</active>
    <allowRecall>false</allowRecall>
    <allowedSubmitters>
        <type>owner</type>
    </allowedSubmitters>
    <approvalPageFields>
        <field>Account_Name_2__c</field>
        <field>Name</field>
        <field>Owner</field>
        <field>Account_Classification__c</field>
        <field>Account_Subclassification__c</field>
        <field>RecordType</field>
        <field>BillingAddress</field>
    </approvalPageFields>
    <approvalStep>
        <allowDelegate>false</allowDelegate>
        <assignedApprover>
            <approver>
                <name>dmas@porcelanosagrupo.com</name>
                <type>user</type>
            </approver>
            <approver>
                <name>eloy.selles@porcelanosagrupo.com</name>
                <type>user</type>
            </approver>
            <whenMultipleApprovers>FirstResponse</whenMultipleApprovers>
        </assignedApprover>
        <label>Step 1</label>
        <name>Step_1</name>
    </approvalStep>
    <emailTemplate>Accounts/Approver_Franchise</emailTemplate>
    <enableMobileDeviceAccess>false</enableMobileDeviceAccess>
    <entryCriteria>
        <booleanFilter>1 AND (2 OR 3 OR 4 OR 5 OR 6)</booleanFilter>
        <criteriaItems>
            <field>Account.Account_Classification__c</field>
            <operation>equals</operation>
            <value>Brand/Chain/Franchise</value>
        </criteriaItems>
        <criteriaItems>
            <field>Account.Account_Subclassification__c</field>
            <operation>equals</operation>
            <value>Automotive</value>
        </criteriaItems>
        <criteriaItems>
            <field>Account.Account_Subclassification__c</field>
            <operation>equals</operation>
            <value>Big-Box</value>
        </criteriaItems>
        <criteriaItems>
            <field>Account.Account_Subclassification__c</field>
            <operation>equals</operation>
            <value>Consumer Goods</value>
        </criteriaItems>
        <criteriaItems>
            <field>Account.Account_Subclassification__c</field>
            <operation>equals</operation>
            <value>Food &amp; Beverage</value>
        </criteriaItems>
        <criteriaItems>
            <field>Account.Account_Subclassification__c</field>
            <operation>equals</operation>
            <value>Cruises</value>
        </criteriaItems>
    </entryCriteria>
    <finalApprovalActions>
        <action>
            <name>Activity_Level_Update</name>
            <type>Alert</type>
        </action>
        <action>
            <name>Updtae_to_Active</name>
            <type>FieldUpdate</type>
        </action>
    </finalApprovalActions>
    <finalApprovalRecordLock>false</finalApprovalRecordLock>
    <finalRejectionRecordLock>true</finalRejectionRecordLock>
    <initialSubmissionActions>
        <action>
            <name>Status_Waiting</name>
            <type>FieldUpdate</type>
        </action>
    </initialSubmissionActions>
    <label>Brand Franchise Account</label>
    <processOrder>1</processOrder>
    <recordEditability>AdminOrCurrentApprover</recordEditability>
    <showApprovalHistory>true</showApprovalHistory>
</ApprovalProcess>
