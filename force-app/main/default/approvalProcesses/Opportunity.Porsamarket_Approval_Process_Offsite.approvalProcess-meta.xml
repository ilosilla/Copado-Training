<?xml version="1.0" encoding="UTF-8"?>
<ApprovalProcess xmlns="http://soap.sforce.com/2006/04/metadata">
    <active>true</active>
    <allowRecall>false</allowRecall>
    <allowedSubmitters>
        <type>owner</type>
    </allowedSubmitters>
    <approvalPageFields>
        <field>Account</field>
        <field>Name</field>
        <field>Owner</field>
        <field>PorsaMarketId__c</field>
        <field>Product_Categories__c</field>
    </approvalPageFields>
    <approvalStep>
        <allowDelegate>false</allowDelegate>
        <assignedApprover>
            <approver>
                <name>dmas@porcelanosagrupo.com</name>
                <type>user</type>
            </approver>
            <approver>
                <name>ivan.losilla@porcelanosagrupo.com</name>
                <type>user</type>
            </approver>
            <approver>
                <name>javier.cortes@porcelanosagrupo.com</name>
                <type>user</type>
            </approver>
            <approver>
                <name>silvestre.segarra@porcelanosa.com</name>
                <type>user</type>
            </approver>
            <whenMultipleApprovers>FirstResponse</whenMultipleApprovers>
        </assignedApprover>
        <label>PM Opp Offsite</label>
        <name>PM_Opp_Offsite</name>
    </approvalStep>
    <description>If a new Opportunity is created with Offsite as a Product Categoies, start the approval flow</description>
    <emailTemplate>unfiled$public/PM_Offsite_Approval</emailTemplate>
    <enableMobileDeviceAccess>false</enableMobileDeviceAccess>
    <entryCriteria>
        <criteriaItems>
            <field>Opportunity.LeadSource</field>
            <operation>equals</operation>
            <value>Porsamarket</value>
        </criteriaItems>
        <criteriaItems>
            <field>Opportunity.ProjectType__c</field>
            <operation>equals</operation>
            <value>PMAPPROVALFLOW</value>
        </criteriaItems>
    </entryCriteria>
    <finalApprovalActions>
        <action>
            <name>PM_Unlock</name>
            <type>FieldUpdate</type>
        </action>
    </finalApprovalActions>
    <finalApprovalRecordLock>false</finalApprovalRecordLock>
    <finalRejectionActions>
        <action>
            <name>PM_Delete</name>
            <type>FieldUpdate</type>
        </action>
    </finalRejectionActions>
    <finalRejectionRecordLock>false</finalRejectionRecordLock>
    <label>Porsamarket Approval Process - Offsite</label>
    <processOrder>1</processOrder>
    <recordEditability>AdminOnly</recordEditability>
    <showApprovalHistory>true</showApprovalHistory>
</ApprovalProcess>
