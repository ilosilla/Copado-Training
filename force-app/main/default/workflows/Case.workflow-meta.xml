    <rules>
        <fullName>Case approved and compensation defined</fullName>
        <actions>
            <name>Financial_Department_Case_status_pending_solution_and_compensation</name>
            <type>Alert</type>
        </actions>
        <active>true</active>
        <criteriaItems>
            <field>Case.Compensation__c</field>
            <operation>notEqual</operation>
        </criteriaItems>
        <criteriaItems>
            <field>Case.Approved__c</field>
            <operation>equals</operation>
            <value>True</value>
        </criteriaItems>
        <description>Email notification to the financial department when a compensation is defined and it has been approved by the delegated approver</description>
        <triggerType>onCreateOrTriggeringUpdate</triggerType>
    </rules>
    <rules>
        <fullName>Case assigned to global queue</fullName>
        <actions>
            <name>Reporter_Edit_case_Porcelanosa_web_link</name>
            <type>Alert</type>
        </actions>
        <actions>
            <name>Fill_Date_case_form_link_email_sent</name>
            <type>FieldUpdate</type>
        </actions>
        <active>true</active>
        <criteriaItems>
            <field>Case.OwnerId</field>
            <operation>equals</operation>
            <value>USA Unknown</value>
        </criteriaItems>
        <description>Once these cases are assigned to the global queue, an auto response email will be sent with a form link to a Porcelanosa web page.</description>
        <triggerType>onCreateOrTriggeringUpdate</triggerType>
    </rules>
    <rules>
        <fullName>Case changes status to pending solution</fullName>
        <actions>
            <name>Reporter_Accept_proposed_solution</name>
            <type>Alert</type>
        </actions>
        <active>true</active>
        <description>If the cases status changes to pending solution and the customer has not agree the suggested solution --&gt; Send email</description>
        <formula>ISCHANGED(Status) &amp;&amp; ISPICKVAL(Status,&apos;7&apos;) &amp;&amp;  NOT(Customer_agrees_with_the_solution__c )</formula>
        <triggerType>onAllChanges</triggerType>
    </rules>
    <rules>
        <fullName>Case customer conclusion is not ok</fullName>
        <active>true</active>
        <booleanFilter>1 OR 2</booleanFilter>
        <criteriaItems>
            <field>Case.Customer_service_conclusion__c</field>
            <operation>equals</operation>
            <value>No ok</value>
        </criteriaItems>
        <criteriaItems>
            <field>Case.Customer_service_conclusion__c</field>
            <operation>equals</operation>
            <value>Ok but unsatisfied</value>
        </criteriaItems>
        <description>If the Customer service conclusion is “No Ok” or “Ok but unsatisfied”,task to charles</description>
        <triggerType>onCreateOrTriggeringUpdate</triggerType>
    </rules>
    <rules>
        <fullName>Case customer identified and reporter refuses</fullName>
        <actions>
            <name>Reporter_Identify_invoices_lines_site_link</name>
            <type>Alert</type>
        </actions>
        <active>true</active>
        <description>If the reporter refuses to attach photos and the customer is identified, send email to identify invoices</description>
        <formula>NOT(ISBLANK(Customer__c )) &amp;&amp; 	Reporter_refuse_to_attach_photos__c &amp;&amp; Customer__c == ContactId</formula>
        <triggerType>onCreateOrTriggeringUpdate</triggerType>
    </rules>
    <rules>
        <fullName>Case customer not identified and reporter refuses</fullName>
        <actions>
            <name>Reporter_refuses_to_attach_photo_and_customer_not_identified</name>
            <type>Task</type>
        </actions>
        <active>true</active>
        <description>If the reporter refuses to attach photos and the customer is not identified, task to charles</description>
        <formula>ISBLANK(Customer__c ) &amp;&amp; 	Reporter_refuse_to_attach_photos__c</formula>
        <triggerType>onCreateOrTriggeringUpdate</triggerType>
    </rules>
    <rules>
        <fullName>Case delivery date filled</fullName>
        <actions>
            <name>Reporter_Case_delivery_date_filled</name>
            <type>Alert</type>
        </actions>
        <active>true</active>
        <description>Email notification to the customer when the estimated delivery date in the claim is filled</description>
        <formula>NOT(ISBLANK(Estimated_delivery_date__c)) &amp;&amp; 	ISCHANGED(Estimated_delivery_date__c)</formula>
        <triggerType>onAllChanges</triggerType>
    </rules>
    <rules>
        <fullName>Case form email sent and not filled</fullName>
        <active>true</active>
        <description>Once the case by email has been created, sent the web form link and not filled by customer in 48 hours, it will be assigned to USA global queue (omni) in order to be manage by an agent.</description>
        <formula>NOT(ISBLANK(Date_case_form_link_email_sent__c )) &amp;&amp; 	 ISBLANK(Date_reporter_filled_the_form__c )</formula>
        <triggerType>onCreateOrTriggeringUpdate</triggerType>
        <workflowTimeTriggers>
            <actions>
                <name>Assign_to_USA_Global_queue_omni</name>
                <type>FieldUpdate</type>
            </actions>
            <offsetFromField>Case.CreatedDate</offsetFromField>
            <timeLength>48</timeLength>
            <workflowTimeTriggerUnit>Hours</workflowTimeTriggerUnit>
        </workflowTimeTriggers>
    </rules>
    <rules>
        <fullName>Case is created via email-to-case</fullName>
        <actions>
            <name>Reporter_Case_created</name>
            <type>Alert</type>
        </actions>
        <active>true</active>
        <description>Email notification to the customer when a case is correctly created and assigned to him via email-to-case system</description>
        <formula>ISPICKVAL(Origin,&apos;Email&apos;)</formula>
        <triggerType>onCreateOnly</triggerType>
    </rules>
    <rules>
        <fullName>Case is reopened</fullName>
        <actions>
            <name>Owner_Case_reopened</name>
            <type>Alert</type>
        </actions>
        <active>true</active>
        <criteriaItems>
            <field>Case.Reopened__c</field>
            <operation>equals</operation>
            <value>True</value>
        </criteriaItems>
        <description>Email notification to the owner when his case has been reopened</description>
        <triggerType>onCreateOrTriggeringUpdate</triggerType>
    </rules>
    <rules>
        <fullName>Case photos not attached and reporter refuses</fullName>
        <active>true</active>
        <criteriaItems>
            <field>Case.Date_Photos_attached__c</field>
            <operation>equals</operation>
        </criteriaItems>
        <criteriaItems>
            <field>Case.Date_reporter_called_to_attach_photos__c</field>
            <operation>notEqual</operation>
        </criteriaItems>
        <description>24 hours since the agent checks the reporter called field and photos has not been attached</description>
        <triggerType>onCreateOrTriggeringUpdate</triggerType>
        <workflowTimeTriggers>
            <actions>
                <name>Check_reporter_refused_to_attach_photo</name>
                <type>FieldUpdate</type>
            </actions>
            <offsetFromField>Case.Date_reporter_called_to_attach_photos__c</offsetFromField>
            <timeLength>24</timeLength>
            <workflowTimeTriggerUnit>Hours</workflowTimeTriggerUnit>
        </workflowTimeTriggers>
    </rules>
    <rules>
        <fullName>Case qualified as Others</fullName>
        <actions>
            <name>Reporter_Case_qualified_as_others</name>
            <type>Alert</type>
        </actions>
        <active>true</active>
        <description>When a case qualification is updated to Others, notify reporter</description>
        <formula>ISCHANGED(Other_qualification__c) &amp;&amp; NOT(ISBLANK(Other_qualification__c))</formula>
        <triggerType>onAllChanges</triggerType>
    </rules>
    <rules>
        <fullName>Case service date filled</fullName>
        <actions>
            <name>Reporter_Service_date_filled</name>
            <type>Alert</type>
        </actions>
        <active>true</active>
        <description>Email notification to the customer when the service date in the claim is filled</description>
        <formula>NOT(ISBLANK(Service_date__c)) &amp;&amp; ISCHANGED(Service_date__c)</formula>
        <triggerType>onAllChanges</triggerType>
    </rules>
    <rules>
        <fullName>Case status changed and not closed</fullName>
        <active>true</active>
        <booleanFilter>1 and 2</booleanFilter>
        <criteriaItems>
            <field>Case.Status</field>
            <operation>notEqual</operation>
            <value>9</value>
        </criteriaItems>
        <criteriaItems>
            <field>Case.Status</field>
            <operation>notEqual</operation>
            <value>8</value>
        </criteriaItems>
        <description>If a case remains in the same status more than 1 week, it is going to be automatically checked by the system as “Stopped”.</description>
        <triggerType>onCreateOrTriggeringUpdate</triggerType>
        <workflowTimeTriggers>
            <actions>
                <name>Mark_as_stopped</name>
                <type>FieldUpdate</type>
            </actions>
            <offsetFromField>Case.Date_last_status_change__c</offsetFromField>
            <timeLength>7</timeLength>
            <workflowTimeTriggerUnit>Days</workflowTimeTriggerUnit>
        </workflowTimeTriggers>
    </rules>
    <rules>
        <fullName>Case status changed from qualification to SKU</fullName>
        <actions>
            <name>Reporter_Attach_photos_site_link</name>
            <type>Alert</type>
        </actions>
        <actions>
            <name>Check_Attach_SKU_photos_email_sent</name>
            <type>FieldUpdate</type>
        </actions>
        <active>true</active>
        <criteriaItems>
            <field>Case.Status</field>
            <operation>equals</operation>
            <value>3</value>
        </criteriaItems>
        <criteriaItems>
            <field>Case.Attach_SKU_photos_email_sent__c</field>
            <operation>equals</operation>
        </criteriaItems>
        <description>When a case change from “Request pending to be qualified” to “Claim pending SKU identification”, and email with a link to a site will be sent</description>
        <triggerType>onCreateOrTriggeringUpdate</triggerType>
    </rules>
    <rules>
        <fullName>Case status changed to Claim pending execution</fullName>
        <actions>
            <name>Reporter_Accepted_proposed_solution</name>
            <type>Alert</type>
        </actions>
        <active>true</active>
        <criteriaItems>
            <field>Case.Status</field>
            <operation>equals</operation>
            <value>8</value>
        </criteriaItems>
        <description>Email notification to the customer when case status change to Claim pending execution</description>
        <triggerType>onCreateOrTriggeringUpdate</triggerType>
    </rules>
    <rules>
        <fullName>Case status changed to Closed</fullName>
        <actions>
            <name>Reporter_Case_closed</name>
            <type>Alert</type>
        </actions>
        <active>true</active>
        <criteriaItems>
            <field>Case.Status</field>
            <operation>equals</operation>
            <value>9</value>
        </criteriaItems>
        <criteriaItems>
            <field>Case.ParentId</field>
            <operation>equals</operation>
        </criteriaItems>
        <description>Email notification every time a case is closed</description>
        <triggerType>onCreateOrTriggeringUpdate</triggerType>
    </rules>
    <rules>
        <fullName>Case technician conclusion is No Ok</fullName>
        <actions>
            <name>Technician_Service_conclusion_No_Ok</name>
            <type>Task</type>
        </actions>
        <active>true</active>
        <description>If the Technician service conclusion is “No Ok”,task to charles</description>
        <formula>ISCHANGED(Technician_service_conclusion__c) &amp;&amp; 	 ISPICKVAL(Technician_service_conclusion__c, &apos;No Ok&apos;)</formula>
        <triggerType>onAllChanges</triggerType>
    </rules>
    <rules>
        <fullName>Delivery date filled</fullName>
        <active>true</active>
        <criteriaItems>
            <field>Case.Estimated_delivery_date__c</field>
            <operation>notEqual</operation>
        </criteriaItems>
        <description>If Delivery date is filled, the day of the deilvery, &quot;delivery done&quot; field is going to be checked automatically</description>
        <triggerType>onCreateOrTriggeringUpdate</triggerType>
        <workflowTimeTriggers>
