    <rules>
        <fullName>Account Name UpperCase</fullName>
        <actions>
            <name>Account_Name_UpperCase</name>
            <type>FieldUpdate</type>
        </actions>
        <active>false</active>
        <formula>AND( NOT(IsPersonAccount), OR(ISNEW(),  ISCHANGED( Name ) ))</formula>
        <triggerType>onAllChanges</triggerType>
    </rules>
    <rules>
        <fullName>Default language person account</fullName>
        <actions>
            <name>Update_language_person_account</name>
            <type>FieldUpdate</type>
        </actions>
        <active>true</active>
        <formula>(IsPersonAccount = true) &amp;&amp;  ISBlANK(TEXT(Language__c ))</formula>
        <triggerType>onCreateOnly</triggerType>
    </rules>
    <rules>
        <fullName>PersonAccount Name UpperCase</fullName>
