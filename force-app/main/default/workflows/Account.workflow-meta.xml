        <actions>
            <name>Person_Account_LastName_Uppercase</name>
            <type>FieldUpdate</type>
        </actions>
        <active>false</active>
        <formula>AND( IsPersonAccount ,  OR( ISNEW() ,  ISCHANGED(Name) ) )</formula>
        <triggerType>onAllChanges</triggerType>
    </rules>
