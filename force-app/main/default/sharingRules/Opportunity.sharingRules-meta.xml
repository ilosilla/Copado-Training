    <sharingCriteriaRules>
        <fullName>Custom_Projects_Rule</fullName>
        <accessLevel>Edit</accessLevel>
        <description>Regla que permite a projects modificar las oportunidades de custom projects</description>
        <label>Custom Projects Rule</label>
        <sharedTo>
            <group>ProductManagers</group>
        </sharedTo>
        <criteriaItems>
            <field>InfoType__c</field>
            <operation>equals</operation>
            <value>Custom Project</value>
        </criteriaItems>
        <includeRecordsOwnedByAll>true</includeRecordsOwnedByAll>
    </sharingCriteriaRules>
    <sharingCriteriaRules>
        <fullName>Facades_Rule</fullName>
