    <duplicateRuleFilter>
        <booleanFilter>(1 OR 2) AND 3 AND 4</booleanFilter>
        <duplicateRuleFilterItems>
            <field>PersonEmail</field>
            <operation>notContain</operation>
            <value>porcelanosa</value>
            <sortOrder>1</sortOrder>
            <table>PersonAccount</table>
        </duplicateRuleFilterItems>
        <duplicateRuleFilterItems>
            <field>Email</field>
            <operation>equals</operation>
            <value>jorge.romeo@flat101.es</value>
            <sortOrder>2</sortOrder>
            <table>User</table>
        </duplicateRuleFilterItems>
        <duplicateRuleFilterItems>
            <field>Username</field>
            <operation>notContain</operation>
            <value>apiuser</value>
            <sortOrder>3</sortOrder>
            <table>User</table>
        </duplicateRuleFilterItems>
        <duplicateRuleFilterItems>
            <field>Username</field>
            <operation>notContain</operation>
            <value>loads.user</value>
            <sortOrder>4</sortOrder>
            <table>User</table>
        </duplicateRuleFilterItems>
    </duplicateRuleFilter>
    <duplicateRuleMatchRules>
        <matchRuleSObjectType>PersonAccount</matchRuleSObjectType>
        <matchingRule>Same_Person_Acct_Email</matchingRule>
        <objectMapping xsi:nil="true"/>
    </duplicateRuleMatchRules>
    <isActive>true</isActive>
