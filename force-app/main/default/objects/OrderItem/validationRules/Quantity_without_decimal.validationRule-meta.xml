<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Quantity_without_decimal</fullName>
    <active>true</active>
    <errorConditionFormula>NOT(REGEX(TEXT(Quantity), &quot;^-?\\d+$&quot;))</errorConditionFormula>
    <errorDisplayField>Quantity</errorDisplayField>
    <errorMessage>Quantity with decimals are not allowed</errorMessage>
</ValidationRule>
