<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Other_classification</fullName>
    <active>false</active>
    <errorConditionFormula>AND(ISPICKVAL( Opportunity_Classification__c, &apos;Other (indicate)&apos;) ,  ISBLANK(Other_Classification__c))</errorConditionFormula>
    <errorDisplayField>Other_Classification__c</errorDisplayField>
    <errorMessage>Please, enter the other classification before save</errorMessage>
</ValidationRule>
