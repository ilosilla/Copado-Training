<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>First_stage_OPP_trade_and_retail</fullName>
    <active>false</active>
    <errorConditionFormula>AND(ISNEW(),OR(AND(RecordType.DeveloperName = &quot;Project_trade&quot;, NOT(ISPICKVAL(StageName, &quot;Especificación&quot;))),AND(RecordType.DeveloperName = &quot;Project_retail&quot;, NOT(ISPICKVAL(StageName, &quot;Qualification&quot;)))))</errorConditionFormula>
    <errorDisplayField>StageName</errorDisplayField>
    <errorMessage>You must select the firtst stage</errorMessage>
</ValidationRule>
