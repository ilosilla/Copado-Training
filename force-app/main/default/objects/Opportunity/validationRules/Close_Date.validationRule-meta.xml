<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Close_Date</fullName>
    <active>false</active>
    <errorConditionFormula>AND( CloseDate &lt;  TODAY() ,TRUE)</errorConditionFormula>
    <errorMessage>Close date cannot be older than TODAY</errorMessage>
</ValidationRule>
