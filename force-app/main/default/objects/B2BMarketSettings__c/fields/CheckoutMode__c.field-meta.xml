<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>CheckoutMode__c</fullName>
    <inlineHelpText>Checkout/order model for this market. 

- REGION = served by a subsidiary (current dealer flow). 
- FACTORY = bought direct from factories, order split and credit checked per factory.</inlineHelpText>
    <label>Checkout Mode</label>
    <required>true</required>
    <trackTrending>false</trackTrending>
    <type>Picklist</type>
    <valueSet>
        <restricted>true</restricted>
        <valueSetDefinition>
            <sorted>false</sorted>
            <value>
                <fullName>REGION</fullName>
                <default>true</default>
                <label>Region (via subsidiary)</label>
            </value>
            <value>
                <fullName>FACTORY</fullName>
                <default>false</default>
                <label>Factory (direct)</label>
            </value>
        </valueSetDefinition>
    </valueSet>
</CustomField>
