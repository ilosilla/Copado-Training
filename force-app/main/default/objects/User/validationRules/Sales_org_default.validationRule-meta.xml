<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Sales_org_default</fullName>
    <active>false</active>
    <errorConditionFormula>NOT(
CONTAINS(SalesOrg_Text__c 	,  TEXT(Default_Sales_Organization__c)
)
)</errorConditionFormula>
    <errorDisplayField>Default_Sales_Organization__c</errorDisplayField>
