<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Fill_customer_conclusions</fullName>
    <active>true</active>
    <description>Si se pasa del estado de customer conclusions a otro más avanzado se debe especificar una las conclusiones del cliente</description>
    <errorConditionFormula>ISBLANK(TEXT(Customer_service_conclusion__c)) &amp;&amp; ISCHANGED(Status) &amp;&amp; ISPICKVAL(PRIORVALUE(Status),&apos;10&apos;) &amp;&amp; VALUE(TEXT(PRIORVALUE(Status))) &lt; VALUE(TEXT(Status))</errorConditionFormula>
    <errorDisplayField>Customer_service_conclusion__c</errorDisplayField>
    <errorMessage>Please specify the customer conclusions</errorMessage>
</ValidationRule>
