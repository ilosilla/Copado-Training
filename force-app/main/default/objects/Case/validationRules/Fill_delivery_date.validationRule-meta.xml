<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Fill_delivery_date</fullName>
    <active>true</active>
    <description>Si se pasa del estado de delivery date a otro más avanzado se debe especificar la fecha de delivery</description>
    <errorConditionFormula>ISBLANK(Estimated_delivery_date__c) &amp;&amp; ISCHANGED(Status) &amp;&amp; ISPICKVAL(PRIORVALUE(Status),&apos;8&apos;) &amp;&amp; VALUE(TEXT(PRIORVALUE(Status))) &lt; VALUE(TEXT(Status))</errorConditionFormula>
    <errorDisplayField>Estimated_delivery_date__c</errorDisplayField>
    <errorMessage>Please specify the delivery date</errorMessage>
</ValidationRule>
