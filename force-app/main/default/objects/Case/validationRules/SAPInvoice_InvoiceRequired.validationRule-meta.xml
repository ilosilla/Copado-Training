<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>SAPInvoice_InvoiceRequired</fullName>
    <active>true</active>
    <description>SAP Invoice: Invoice Number Required</description>
    <errorConditionFormula>IsCollection__c == true &amp;&amp;  ISBLANK(SAPInvoice__c)</errorConditionFormula>
    <errorMessage>Please enter a valid SAP invoice number</errorMessage>
</ValidationRule>
