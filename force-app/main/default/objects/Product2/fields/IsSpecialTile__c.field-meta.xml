<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>IsSpecialTile__c</fullName>
    <formula>AND(
    IsTile__c,
    OR(
        ISPICKVAL(SalesUnit__c, &quot;PZS&quot;),
        ISPICKVAL(SalesUnit__c, &quot;UN&quot;)
    )
)</formula>
    <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
    <label>Is Special Tile</label>
    <trackHistory>false</trackHistory>
    <type>Checkbox</type>
</CustomField>
