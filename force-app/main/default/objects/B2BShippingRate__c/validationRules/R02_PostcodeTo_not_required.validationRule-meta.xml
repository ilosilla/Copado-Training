<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>R02_PostcodeTo_not_required</fullName>
    <active>false</active>
    <errorConditionFormula>AND(
  IsPostalNumeric__c = FALSE,
  ISBLANK(PostcodeTo__c) = FALSE
)</errorConditionFormula>
    <errorMessage>PostcodeTo should be blank for alphanumeric postal format.</errorMessage>
</ValidationRule>
