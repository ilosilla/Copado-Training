<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>VR02_Quote_Sent</fullName>
    <active>true</active>
    <description>Quote sent to customer</description>
    <errorConditionFormula>ispickval( State__c , &apos;Quotation Sent&apos; ) &amp;&amp;
