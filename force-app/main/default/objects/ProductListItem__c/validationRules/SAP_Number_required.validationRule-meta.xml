<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>SAP_Number_required</fullName>
    <active>true</active>
    <description>ENsures a SAP number is entered when SAP Document is not empty</description>
    <errorConditionFormula>NOT(ISBLANK(TEXT(SAPDocument__c))) &amp;&amp; (ISBLANK(SAPNumber__c) || SAPNumber__c = &apos;0&apos;)</errorConditionFormula>
    <errorMessage>SAP Document Number is required</errorMessage>
</ValidationRule>
