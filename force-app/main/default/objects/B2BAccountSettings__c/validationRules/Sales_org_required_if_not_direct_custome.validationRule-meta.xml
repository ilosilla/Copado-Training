<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Sales_org_required_if_not_direct_custome</fullName>
    <active>true</active>
    <errorConditionFormula>AND(
    NOT( ISPICKVAL(Market__r.CheckoutMode__c, &quot;FACTORY&quot;) ),
    ISBLANK(SalesOrgId__c)
)</errorConditionFormula>
    <errorMessage>Sales Organization is required for non-factory customer accounts.</errorMessage>
</ValidationRule>
