<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Non_Commercial_Event</fullName>
    <active>false</active>
    <errorConditionFormula>AND(
				ISPICKVAL(EventType__c, &quot;Non Commercial&quot;) ,
				OR(NOT(ISBLANK(WhoId)),(NOT(ISBLANK(WhatId)
																																))))</errorConditionFormula>
    <errorMessage>Do not Relate a record with this type of Event</errorMessage>
</ValidationRule>
