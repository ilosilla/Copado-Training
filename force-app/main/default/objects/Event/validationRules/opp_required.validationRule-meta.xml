<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>opp_required</fullName>
    <active>false</active>
    <errorConditionFormula>AND(NOT(BEGINS(WhatId, &quot;006&quot;)) , ISPICKVAL(Type, &quot;Opportunity Follow Up Meeting&quot;) 
)</errorConditionFormula>
    <errorDisplayField>WhatId</errorDisplayField>
    <errorMessage>You must select an Opportunity</errorMessage>
</ValidationRule>
