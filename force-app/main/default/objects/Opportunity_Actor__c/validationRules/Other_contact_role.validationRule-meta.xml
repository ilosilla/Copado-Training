<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Other_contact_role</fullName>
    <active>false</active>
    <errorConditionFormula>AND(ISPICKVAL( Role__c, &apos;Other (indicate)&apos;) , ISBLANK(Other_Contact_Role__c))</errorConditionFormula>
    <errorDisplayField>Other_Contact_Role__c</errorDisplayField>
    <errorMessage>Please, enter the other role before save</errorMessage>
</ValidationRule>
