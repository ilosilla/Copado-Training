<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Postal_code_billing_FR</fullName>
    <active>true</active>
    <errorConditionFormula>AND(CONTAINS($User.Username, &apos;loads.user&apos;) = false,NOT(ISBLANK(BillingPostalCode)),AND(ISPICKVAL(BillingCountryCode, &quot;FR&quot; ), 
NOT(REGEX(BillingPostalCode,  &apos;^(F-)?\\d{5}$&apos;)) 
))</errorConditionFormula>
    <errorMessage>Invalid FR post code for Account</errorMessage>
</ValidationRule>
