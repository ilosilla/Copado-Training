<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Postal_code_personal_GB</fullName>
    <active>true</active>
    <description>Invalid GB postal code</description>
    <errorConditionFormula>AND( CONTAINS($User.Username, &apos;loads.user&apos;) = false,
(IsPersonAccount=True),
(ISPICKVAL(PersonMailingCountryCode, &quot;GB&quot;) ), 
NOT(REGEX(PersonMailingPostalCode, &quot;([Gg][Ii][Rr] 0[Aa][Aa])|((([a-zA-Z-[QVXqvx]][0-9][0-9]?)|(([a-zA-Z-[QVXqvx]][a-zA-Z-[IJZijz]][0-9][0-9]?)|(([a-zA-Z-[QVXqvx]][0-9][aA-HJKSTUWhjkstuw])|([a-zA-Z-[QVXqvx]][a-zA-Z-[IJZijz]][0-9][ABEHMNPRVWXYabehmnprvwxy])))) [0-9][a-zA-Z-[CIKMOVcikmov]]{2})&quot;)) 
)</errorConditionFormula>
    <errorMessage>Invalid GB postal code for a personAccount</errorMessage>
</ValidationRule>
