<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>country_character</fullName>
    <active>false</active>
    <errorConditionFormula>NOT ( REGEX ( Country__c,&quot;[a-zA-Z ]*&quot; ))</errorConditionFormula>
    <errorDisplayField>Country__c</errorDisplayField>
    <errorMessage>No se puede introducir un campo erróneo.</errorMessage>
</ValidationRule>
