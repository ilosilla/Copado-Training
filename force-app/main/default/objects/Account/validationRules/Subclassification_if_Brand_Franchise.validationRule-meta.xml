<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Subclassification_if_Brand_Franchise</fullName>
    <active>true</active>
    <description>Si seleccionan Brand/Franchise, es obligatorio una subclassificación</description>
    <errorConditionFormula>AND(
ISPICKVAL(Account_Classification__c, &apos;Brand/Chain/Franchise&apos;),  
ISPICKVAL( Account_Subclassification__c ,&apos;&apos; ))</errorConditionFormula>
    <errorDisplayField>Account_Subclassification__c</errorDisplayField>
    <errorMessage>Subclassification is required</errorMessage>
</ValidationRule>
