<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Postal_code_personal_CH</fullName>
    <active>true</active>
    <errorConditionFormula>AND(CONTAINS($User.Username, &apos;loads.user&apos;) = false,NOT(ISBLANK(PersonMailingPostalCode)),AND(ISPICKVAL(PersonMailingCountryCode, &quot;CH&quot; ),
NOT(REGEX(PersonMailingPostalCode, &apos;^[1-9]\\d{3}$&apos;))
))</errorConditionFormula>
    <errorMessage>Invalid Switzerland personAccount post code</errorMessage>
</ValidationRule>
