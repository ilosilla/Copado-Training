<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Postal_code_personal_FR</fullName>
    <active>true</active>
    <errorConditionFormula>AND(CONTAINS($User.Username, &apos;loads.user&apos;) = false,NOT(ISBLANK(PersonMailingPostalCode)),AND(ISPICKVAL(PersonMailingCountryCode, &quot;FR&quot; ),  
NOT(REGEX(PersonMailingPostalCode,  &apos;^(F-)?\\d{5}$&apos;)) 
))</errorConditionFormula>
    <errorMessage>Invalid FR personAccount post code</errorMessage>
</ValidationRule>
