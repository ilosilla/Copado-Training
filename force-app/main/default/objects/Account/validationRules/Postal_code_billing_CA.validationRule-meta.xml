<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Postal_code_billing_CA</fullName>
    <active>true</active>
    <errorConditionFormula>AND(CONTAINS($User.Username, &apos;loads.user&apos;) = false,NOT(ISBLANK(BillingPostalCode)),AND(ISPICKVAL(BillingCountryCode, &quot;CA&quot; ),
NOT(REGEX(BillingPostalCode, &apos;^([ABCEGHJKLMNPRSTVXY]\\d[ABCEGHJKLMNPRSTVWXYZ])\\ ({0,1}\\d[ABCEGHJKLMNPRSTVWXYZ]\\d)$&apos;))
))</errorConditionFormula>
    <errorMessage>Invalid CA post code for Account</errorMessage>
</ValidationRule>
