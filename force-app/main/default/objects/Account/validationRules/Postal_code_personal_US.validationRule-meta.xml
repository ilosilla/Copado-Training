<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Postal_code_personal_US</fullName>
    <active>true</active>
    <errorConditionFormula>AND(CONTAINS($User.Username, &apos;loads.user&apos;) = false,NOT(ISBLANK(PersonMailingPostalCode)),AND(ISPICKVAL(PersonMailingCountryCode, &quot;US&quot; ),
NOT(REGEX(PersonMailingPostalCode, &apos;^(\\d{5}(\\-\\d{4})?)?$&apos;))
))</errorConditionFormula>
    <errorMessage>Invalid US personAccount post code</errorMessage>
</ValidationRule>
