<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Postal_code_billing_CH</fullName>
    <active>true</active>
    <description>Invalid CH post code for Account</description>
    <errorConditionFormula>AND(CONTAINS($User.Username, &apos;loads.user&apos;) = false,NOT(ISBLANK(BillingPostalCode)),AND(ISPICKVAL(BillingCountryCode, &quot;CH&quot; ),
NOT(REGEX(BillingPostalCode, &apos;^[1-9]\\d{3}$&apos;))
))</errorConditionFormula>
    <errorMessage>Invalid Swotzerland post code for Account</errorMessage>
</ValidationRule>
