                            <td>{!r.Priority__c}</td>
                        </tr>
                        <tr>
                            <th class="w-20" colspan="3">Comentario</th>
                        </tr>
                        <tr>
                            <td class="prewrap" colspan="3"><apex:outputText value="{!r.Comment__c}"></apex:outputText></td>
                        </tr>
                        <tr>
                            <th class="w-20" colspan="3">Archivos Adjuntos</th>
                        </tr>
                        <tr>
                            <td colspan="3">
                                <ul>
                                    <apex:repeat value="{!files[r.Id]}" var="f">
                                        <li>
                                            <a class="pdf-link" target="_blank" href="{!baseurl & '/sfc/servlet.shepherd/document/download/' & f.ContentDocumentId}">
                                                {!f.ContentDocument.Title}.{!f.ContentDocument.FileExtension}
                                            </a>
                                        </li>
                                    </apex:repeat>
                                </ul>
                            </td>
                        </tr>
                    </table>
                </div>
            </apex:repeat>
        </apex:repeat>
       
        <apex:repeat value="{!strategyWrappers}" var="sw">            
            <apex:repeat value="{!sw.requests}" var="r">
                <div class="no-break">
                    <table class="subtable">
                        <tr>
                            <th style="background-color:{!IF(r.Priority__c='HIGH', '#FFCFC4', IF(r.Priority__c='MEDIUM', '#FFFEC7', IF(r.Priority__c='LOW', '#f0f0f0', '#f0f0f0')))};text-align:center;" class="w-20" colspan="3">Solicitud <a target="_blank" href="{! baseUrl & '/' & r.Id }">{!r.Name}</a></th>
                        </tr>
                        <tr>
                            <th class="w-20" >Estratégia</th>
                            <th class="w-20" >Título</th>
                            <th class="w-20" >Prioridad</th>
                        </tr>
                        <tr>
                            <td class="w-20"><a target="_blank" href="{! baseUrl & '/' & r.BusinessTripStrategy__r.Id }">{!r.BusinessTripStrategy__r.Name}</a></td>
                            <td>{!r.Title__c}</td>
                            <td>{!r.Priority__c}</td>
                        </tr>
                        <tr>
                            <th class="w-20" colspan="3">Comentario</th>
                        </tr>
                        <tr>
                            <td class="prewrap" colspan="3"><apex:outputText value="{!r.Comment__c}"></apex:outputText></td>
                        </tr>
                        <tr>
                            <th class="w-20" colspan="3">Archivos Adjuntos</th>
                        </tr>
                        <tr>
                            <td colspan="3">
                                <ul>
                                    <apex:repeat value="{!files[r.Id]}" var="f">
                                        <li>
                                            <a class="pdf-link" target="_blank" href="{!baseurl & '/sfc/servlet.shepherd/document/download/' & f.ContentDocumentId}">
                                                {!f.ContentDocument.Title}.{!f.ContentDocument.FileExtension}
                                            </a>
                                        </li>
                                    </apex:repeat>
                                </ul>
                            </td>
                        </tr>
                    </table>
                </div>    
            </apex:repeat>
        </apex:repeat>
    </div>

</body>
</html>
