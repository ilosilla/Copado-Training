<apex:page renderAs="pdf" applyBodyTag="false" applyHtmlTag="false" showHeader="false" controller="WeeklyManagementPdfController">
<html>
<head>
    <style type="text/css">
        @page { size: A4 portrait; margin: 2cm; }
        body { font-family: Arial, sans-serif; font-size: 10px; line-height: 1.4; }
        h1 { text-align: center; margin: 0; font-size: 18px; }
        h2 { margin: 20px 0 10px 0; font-size: 14px; color: #2a2a2a; border-bottom: 1px solid #ccc; padding-bottom: 3px; }
        h3.subtitle { text-align: center; margin: 5px 0 20px 0; font-weight: normal; font-size: 11px; color: #555; }
        .section-intro { font-style: italic; margin: 0 0 10px 0; }
        .event-block, .acc-block, .opp-block { border: 1px solid #ccc; padding: 8px; margin-bottom: 10px; border-radius: 4px; background: #f9f9f9; }
        .event-block strong, .acc-block strong, .opp-block strong { display:block; margin-bottom:3px; }
        .label { font-weight: bold; }
        .page-break { page-break-after: always; }
    </style>
</head>
<body>
    <h1>Rapport Hebdomadaire de Gestion</h1>

    <!-- Sous-titre avec utilisateur et dates -->
    <h3 class="subtitle">
        Utilisateur : {!userName} <br/>
        Période couverte : {!startDate} – {!endDate}
    </h3>

    <p style="text-align:center; font-size:11px; margin-bottom:20px;">
        Ce rapport résume l'activité commerciale et relationnelle réalisée durant la semaine, 
        en mettant en évidence les événements, comptes clés et opportunités nécessitant une attention particulière.
    </p>

    <!-- Résumé hebdomadaire -->
    <apex:outputPanel >
        <div class="block">
            <strong>Résumé de la semaine :</strong>
            <div>{!weekComment}</div>
        </div>
    </apex:outputPanel>

    <!-- Section Événements -->
    <apex:outputPanel rendered="{!events.size > 0}">
        <div class="page-break">
            <h2>1. Événements Planifiés et Réalisés</h2>
            <p class="section-intro">
                Le tableau suivant présente les réunions, visites et autres interactions organisées au cours de la semaine. 
                Chaque bloc contient les détails du type d'événement, du compte ou du contact impliqué, 
                ainsi que l'information si la réunion a été annulée ou réalisée.
            </p>
            <apex:repeat value="{!events}" var="evt">
                <div class="event-block">
                    <strong>{!evt.Subject}</strong>
                    <span class="label">Type :</span> {!evt.EventType}<br/>
                    <span class="label">Compte :</span> {!evt.AccountName}<br/>
                    <span class="label">Contact :</span> {!evt.ContactName}<br/>
                    <span class="label">Date et Heure :</span> {!evt.StartDateTime}<br/>
                    <span class="label">Annulé :</span> {!IF(evt.Cancelled = 'true', 'Oui', 'Non')}<br/>
                    <span class="label">Responsable :</span> {!evt.OwnerName}<br/>
                    <span class="label">Commentaires :</span> <div>{!evt.Description}</div>
                </div>
            </apex:repeat>
        </div>
    </apex:outputPanel>

    <!-- Commentaires des Comptes Clés -->
    <apex:outputPanel rendered="{!accComments.size > 0}">
        <div class="page-break">
            <h2>2. Comptes Clés – Notes Stratégiques</h2>
            <p class="section-intro">
                Les comptes clés sont ceux ayant le plus fort impact commercial. 
                Les commentaires suivants reflètent leur état actuel, leur maturité dans le cycle de vente, 
                ainsi que les considérations stratégiques observées durant la semaine.
            </p>
            <apex:repeat value="{!accComments}" var="accComment">
                <div class="acc-block">
                    <strong>{!accComment.Account__r.Name}</strong>
                    <span class="label">Maturité commerciale :</span> {!accComment.Account__r.SalesMaturity__c}<br/>
                    <span class="label">Commentaire :</span> <div>{!accComment.Value__c}</div>
                </div>
            </apex:repeat>
        </div>
    </apex:outputPanel>

    <!-- Commentaires des Opportunités -->
    <apex:outputPanel rendered="{!oppComments.size > 0}">
        <div class="page-break">
            <h2>3. Opportunités clés - Notes stratégiques</h2>
            <p class="section-intro">
                Les opportunités représentent des revenus potentiels et de nouveaux projets. 
                Ci-dessous se trouvent les commentaires sur les opportunités les plus pertinentes identifiées ou traitées cette semaine, 
                en soulignant les avancées, obstacles et prochaines étapes.
            </p>
            <apex:repeat value="{!oppComments}" var="oppComment">
                <div class="opp-block">
                    <strong>{!oppComment.Opportunity__r.Name}</strong>
                    <span class="label">Commentaire :</span> <div>{!oppComment.Value__c}</div>
                </div>
            </apex:repeat>
        </div>
    </apex:outputPanel>

    <p style="margin-top:30px; font-size:11px; text-align:center;">
        — Fin du Rapport Hebdomadaire —
    </p>
</body>
</html>
</apex:page>